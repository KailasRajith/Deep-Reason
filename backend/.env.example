# Server Configuration
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-for-deep-reason

# SQLite Database
DB_PATH=deep_reason.db

# Primary AI Providers
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Default MCTS Hyperparameters
DEFAULT_EXPLORATION_CONSTANT=1.41421356
DEFAULT_MAX_DEPTH=8
DEFAULT_MAX_ITERATIONS=25
DEFAULT_BRANCHING_FACTOR=3
DEFAULT_PRUNE_THRESHOLD=0.25
DEFAULT_TEMPERATURE=0.7

# Default Models
DEFAULT_GENERATOR_PROVIDER=openrouter
DEFAULT_GENERATOR_MODEL=deepseek/deepseek-r1
DEFAULT_EVALUATOR_PROVIDER=openrouter
DEFAULT_EVALUATOR_MODEL=deepseek/deepseek-r1
