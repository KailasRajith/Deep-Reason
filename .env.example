# ============================================================
# DEEP REASON — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-for-deep-reason
DB_PATH=deep_reason.db

# Frontend URLs (for local development or production proxies)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ------------------------------------------------------------
# Upstream AI Provider Credentials
# (Can be supplied via .env or entered interactively via the /models UI)
# ------------------------------------------------------------

# 1. OpenRouter (Unified Frontier Gateway — Claude 3.5, DeepSeek R1, GPT-4o, etc.)
OPENROUTER_API_KEY=

# 2. Google Gemini (Direct high-throughput provider — Gemini 2.0 Flash / 1.5 Pro)
GEMINI_API_KEY=

# 3. OpenAI Compatible (OpenAI, Groq LPU, Ollama, LM Studio)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------
# Default MCTS Hyperparameters
# ------------------------------------------------------------
DEFAULT_EXPLORATION_CONSTANT=1.41421356
DEFAULT_MAX_DEPTH=8
DEFAULT_MAX_ITERATIONS=25
DEFAULT_BRANCHING_FACTOR=3
DEFAULT_PRUNE_THRESHOLD=0.25
DEFAULT_TEMPERATURE=0.7

# Default Providers & Models
DEFAULT_GENERATOR_PROVIDER=openrouter
DEFAULT_GENERATOR_MODEL=deepseek/deepseek-r1
DEFAULT_EVALUATOR_PROVIDER=openrouter
DEFAULT_EVALUATOR_MODEL=deepseek/deepseek-r1
